{
  "name": "gome-remote",
  "version": "0.2.0",
  "private": true,
  "description": "A Tailscale-only remote desktop for your machines",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "gateway": "node server/index.js",
    "test": "node --test test/*.test.js",
    "check": "tsc --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "net.gome.remote",
    "productName": "Gome Remote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "vendor/LICENSE",
      "vendor/NOTICE",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  }
}
